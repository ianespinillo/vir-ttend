# Puertos expuestos en el Host
CLIENT_PORT=3000
API_PORT=3001
POSTGRES_PORT=5436
REDIS_PORT=6379

# Variables de la API
JWT_SECRET=vir_ttend_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=vir_ttend_super_secret_refresh_jwt_key_2026
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# Variables del Cliente (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TENANCY_MODE=multi

# ==========================================
# Tenancy Configuration (Multi vs Single Tenant)
# ==========================================
TENANCY_MODE=multi
# TENANT_ID=00000000-0000-0000-0000-000000000001
# TENANT_SLUG=colegio-nacional
# TENANT_NAME=Colegio Nacional
# ALLOW_SUPERADMIN=false
# BOOTSTRAP_ADMIN_EMAIL=admin@colegio-nacional.edu.ar
# BOOTSTRAP_ADMIN_PASSWORD=ContraseñaFuerte123!

# ==========================================
# Email (SMTP) — ver apps/api/.env.example
# ==========================================
EMAIL_ENABLED=false
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=usuario-smtp
# SMTP_PASS=clave-smtp
# SMTP_FROM="Vir-ttend <no-reply@tu-dominio>"
