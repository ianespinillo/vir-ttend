# ============================================================
# Vir-ttend — Production Environment (Single-Tenant)
# ============================================================
# Copy this file to .env.production and fill every value.
# NEVER commit .env.production to git.
# Fields marked [REQUIRED] will cause the app to refuse to start if missing.
# Fields marked [GENERATE] must be unique per deployment — use:
#   openssl rand -base64 48
# ============================================================


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# [REQUIRED] Database user
POSTGRES_USER=virttend

# [REQUIRED] Database password — change this
POSTGRES_PASSWORD=change_me_strong_password

# [REQUIRED] Database name
POSTGRES_DB=vir_ttend


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

# [REQUIRED] Redis password — must not be empty in production
REDIS_PASSWORD=change_me_redis_password


# ------------------------------------------------------------
# JWT Secrets
# [GENERATE] Both values must be unique, long, and different
#            from each other and from any other deployment.
#            Run: openssl rand -base64 48
# ------------------------------------------------------------

JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_GENERATED_SECRET


# ------------------------------------------------------------
# URLs & CORS
# [REQUIRED] Set to the real public domain of this deployment.
# ------------------------------------------------------------

# Public URL of the API (used by the Next.js client at build time)
# Example: https://api.colegio-san-martin.edu.ar
NEXT_PUBLIC_API_URL=https://api.your-school-domain.com

# Comma-separated list of allowed CORS origins (no trailing slash)
# Must include the public client domain only
CORS_ORIGINS=https://your-school-domain.com


# ------------------------------------------------------------
# Single-Tenant Identity
# [REQUIRED] All three fields are mandatory in single mode.
# ------------------------------------------------------------

# Stable UUID for this tenant — generate once and NEVER change it.
# If you change it after the first run, the database won't match.
# Run: node -e "console.log(require('crypto').randomUUID())"
TENANT_ID=REPLACE_WITH_GENERATED_UUID

# Short slug — lowercase, hyphens only, no spaces
# Example: colegio-san-martin
TENANT_SLUG=your-school-slug

# Human-readable name shown in the UI
TENANT_NAME=Your School Name


# ------------------------------------------------------------
# School Bootstrap
# Runs once on first start. Idempotent — safe to restart.
# ------------------------------------------------------------

# Name shown in the application
SCHOOL_NAME=Your School Name

# Comma-separated levels. Allowed values: PRIMARY, SECONDARY
SCHOOL_LEVELS=PRIMARY,SECONDARY

# First admin account created automatically
BOOTSTRAP_ADMIN_EMAIL=admin@your-school-domain.com
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=Institucional

# [OPTIONAL] If left empty, a secure password is auto-generated
#            and printed once to stdout on first boot.
BOOTSTRAP_ADMIN_PASSWORD=


# ------------------------------------------------------------
# Access Control
# ------------------------------------------------------------

# Set to false to block superadmin login on this instance.
# Only set to true temporarily for support access.
ALLOW_SUPERADMIN=false
