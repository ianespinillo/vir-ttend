# Base URL of the Vir-ttend API.
# Defaults to http://localhost:3001, which a physical phone cannot reach.
# On a phone, point it at the dev machine over the network: its LAN IP (same
# wifi) or its Tailscale IP. Restart Expo with --clear after changing it.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Optional: single | multi (default multi)
# EXPO_PUBLIC_TENANCY_MODE=multi
# EXPO_PUBLIC_APP_NAME=Vir-ttend
# EXPO_PUBLIC_DEFAULT_TENANT_ID=
# EXPO_PUBLIC_DEFAULT_TENANT_NAME=
