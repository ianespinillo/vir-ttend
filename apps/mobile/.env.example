# Base URL of the Vir-ttend API.
# Optional: defaults to http://localhost:3001 on every platform.
# On a physical Android phone over USB (or an emulator), `localhost` reaches the
# laptop through `adb reverse` (run `pnpm --filter mobile android:reverse`).
# Set it only to target a different API (e.g. a LAN IP or an https URL).
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional: single | multi (default multi)
# EXPO_PUBLIC_TENANCY_MODE=multi
# EXPO_PUBLIC_APP_NAME=Vir-ttend
# EXPO_PUBLIC_DEFAULT_TENANT_ID=
# EXPO_PUBLIC_DEFAULT_TENANT_NAME=
