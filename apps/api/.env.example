# API
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virttend

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Deben ser únicos, distintos entre sí y seguros en producción)
JWT_SECRET=change_me_in_production_jwt_secret_32chars
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_32chars

# ==========================================
# Tenancy Configuration (Multi vs Single Tenant)
# ==========================================
# Modo de tenancy: 'multi' (default) o 'single'
TENANCY_MODE=multi

# Obligatorio en modo 'single' (UUID v4 estable del colegio)
# TENANT_ID=00000000-0000-0000-0000-000000000001

# Obligatorio en modo 'single' (slug único para subdominio, logs y aislamiento)
# TENANT_SLUG=colegio-nacional

# Nombre legible del colegio
# TENANT_NAME=Colegio Nacional

# Permite o bloquea el acceso de SUPERADMIN en esta instancia (default: true en multi, false en single)
# ALLOW_SUPERADMIN=false

# Prefijo para claves de Redis / cache (por defecto usa TENANT_SLUG o INSTANCE_ID)
# INSTANCE_ID=colegio-nacional

# Bootstrap automático del primer administrador en modo single
# BOOTSTRAP_ADMIN_EMAIL=admin@colegio-nacional.edu.ar
# BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
# BOOTSTRAP_ADMIN_LAST_NAME=Institucional
# BOOTSTRAP_ADMIN_PASSWORD=ContraseñaFuerte123!