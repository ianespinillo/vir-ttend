# Public URL of this site (canonical URLs, sitemap, Open Graph, QR codes).
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=

# Where "Probar la demo" points (apps/demo deployment).
NEXT_PUBLIC_DEMO_URL=https://vir-ttend-demo.vercel.app

# Where "Ingresar" points (shared instance). The button is hidden when unset.
NEXT_PUBLIC_APP_URL=

# Contact address used by the mailto: links. PLACEHOLDER by default.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@vir-ttend.app
