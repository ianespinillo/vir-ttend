{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
